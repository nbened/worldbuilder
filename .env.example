OPENAI_API_KEY=
# ChatGPT-style image model. Options: gpt-image-2, chatgpt-image-latest, gpt-image-1, gpt-image-1.5
OPENAI_IMAGE_MODEL=gpt-image-2
# Output size for still generate/edit. gpt-image-2 supports 4K (e.g. 3840x2160 / 2160x3840).
OPENAI_IMAGE_SIZE=3840x2160
OPENAI_IMAGE_QUALITY=high

GEMINI_API_KEY=
# Veo model for region animations. Options: veo-3.1-generate-preview, veo-3.1-fast-generate-preview
VEO_MODEL=veo-3.1-fast-generate-preview
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-opus-5
